// Sarthi Transport — shared pilot-test Firebase Storage rules
//
// Paste this into Firebase Console → Storage → Rules, then Publish.
//
// SECURITY NOTE: this intentionally allows any client to read/write every
// file. That's fine for a short trusted pilot with a known group of
// 10-15 testers, but must NOT be used for a public launch — anyone with
// your Firebase config could read/write all uploaded photos. Before a real
// launch: add Firebase Auth (e.g. phone OTP) and scope rules per
// authenticated user.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
