// Apna Transport — production Firebase Storage rules
//
// Paste this into Firebase Console → Storage → Rules, then Publish.
// Requires the same admin custom claim as firestore.rules (see
// scripts/setupAdmin.js) and real Firebase Phone Auth for customers/drivers.
//
// Only the owning driver/customer and admin can read or write a person's
// own KYC documents, vehicle photos, or profile photo — nobody else (not
// even other drivers/customers) ever needs to see these.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function isOwnPhone(mobile) {
      return isSignedIn() && request.auth.token.phone_number == ('+91' + mobile);
    }

    match /drivers/{mobile}/{fileName} {
      allow read, write: if isOwnPhone(mobile) || isAdmin();
    }
    match /customers/{mobile}/{fileName} {
      allow read, write: if isOwnPhone(mobile) || isAdmin();
    }
    match /expenses/{fileName} {
      allow read, write: if isAdmin();
    }

    // Bill & E-Way Bill documents (Original/Duplicate/E-Way Bill scans, plus
    // the merged PDF a Cloud Function writes with the Admin SDK, which
    // always bypasses these rules regardless). Left signed-in-gated rather
    // than owner-scoped, matching the same trade-off already made for the
    // bookings collection itself in firestore.rules (`allow update: if
    // isSignedIn()`) — a customer uploads here, a driver reads here, and
    // there's no single "owning phone" for a two-sided booking doc.
    match /bookings/{bookingId}/documents/{fileName} {
      allow read, write: if isSignedIn();
    }
  }
}
