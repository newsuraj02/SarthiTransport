// Apna Transport — production Firebase Storage rules
//
// Paste this into Firebase Console → Storage → Rules, then Publish
// (or `firebase deploy --only storage`).
// Requires the same admin custom claim as firestore.rules (see
// scripts/setupAdmin.js). Customers/drivers authenticate either via
// Firebase Phone Auth or PIN email/password — see isOwnPhone below.
//
// Only the owning driver/customer and admin can read or write a person's
// own KYC documents, vehicle photos, or profile photo — nobody else (not
// even other drivers/customers) ever needs to see these.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    // Two ways a session can prove it owns a given mobile number, OR'd so
    // neither auth method locks anyone out — must stay in sync with the
    // identical function in firestore.rules:
    //  (1) Firebase Phone Auth — token carries "+91XXXXXXXXXX".
    //  (2) PIN login (App.jsx: CustomerOnboarding/DriverOnboarding) signs in
    //      as an email/password account under a synthetic
    //      "<mobile>@customer.apnatransport.local" / "<mobile>@driver.apnatransport.local"
    //      email (firebaseClient.js: pinAuthEmail). These sessions have NO
    //      phone_number claim — without branch (2), every KYC / profile /
    //      vehicle photo upload was silently permission-denied and fell back
    //      to bloated inline base64 (firestore.rules already has this branch;
    //      this file was missed).
    function isOwnPhone(mobile) {
      return isSignedIn() && (
        request.auth.token.phone_number == ('+91' + mobile) ||
        request.auth.token.email == (mobile + '@customer.apnatransport.local') ||
        request.auth.token.email == (mobile + '@driver.apnatransport.local')
      );
    }

    match /drivers/{mobile}/{fileName} {
      allow read, write: if isOwnPhone(mobile) || isAdmin();
    }
    match /customers/{mobile}/{fileName} {
      allow read, write: if isOwnPhone(mobile) || isAdmin();
    }
    match /expenses/{fileName} {
      allow read, write: if isAdmin();
    }

    // Bill & E-Way Bill documents (Original/Duplicate/E-Way Bill scans, plus
    // the merged PDF a Cloud Function writes with the Admin SDK, which
    // always bypasses these rules regardless). Used to be signed-in-gated
    // only, matching the old (now-tightened) firestore.rules trade-off on
    // the bookings collection itself — any signed-in stranger, not just
    // this booking's own customer/driver, could read or overwrite these.
    // Storage rules have no direct view of a Firestore document's fields,
    // but the firestore.get()/firestore.exists() cross-service functions
    // let a rule reach into Firestore to read one -- used here to pull the
    // booking's customerMobile/driverMobile and check the caller against
    // them the same way firestore.rules' own bookings/{id} update rule
    // does. A booking that doesn't exist (bad bookingId) denies rather
    // than erroring, since firestore.get() itself throws for a missing doc.
    function bookingDoc(bookingId) {
      return firestore.get(/databases/(default)/documents/bookings/$(bookingId)).data;
    }
    match /bookings/{bookingId}/documents/{fileName} {
      allow read, write: if isAdmin()
        || (firestore.exists(/databases/(default)/documents/bookings/$(bookingId)) && (
          isOwnPhone(bookingDoc(bookingId).customerMobile) ||
          (bookingDoc(bookingId).driverMobile != null && isOwnPhone(bookingDoc(bookingId).driverMobile))
        ));
    }
  }
}
