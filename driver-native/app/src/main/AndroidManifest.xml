<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location: fine for real GPS fixes, coarse as the SDK-required
         companion, background for LocationTrackerService continuing to
         write fixes once the app is minimized, see that service's own
         header comment for why this can't be done from Compose/JS timers
         alone. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- See AppFirebaseMessagingService / RingingBookingActivity, the
         "ring like an incoming call" full-screen alert for a new load,
         ported from the main Capacitor app's proven implementation. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Real "ignore battery optimizations" system dialog, see the
         reliability work done on the main Capacitor app this session;
         the exact same OS-level exemption matters here too, for the exact
         same reason (LocationTrackerService + the FCM wake-up both need
         it to survive aggressive OEM background-killing). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".ApnaDriverApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:supportsRtl="true">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen "incoming call" ring screen, see
             ui/ringing/RingingBookingActivity.java. showWhenLocked/
             turnScreenOn cover API 27+ declaratively; that class's own
             legacy window-flag path covers API 24-26 (this project's
             minSdk, same floor as the main app). -->
        <activity
            android:name=".ui.ringing.RingingBookingActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <service
            android:name=".push.AppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- See service/LocationTrackerService.java: foregroundServiceType
             "location" is mandatory on API 29+ for a location-type
             foreground service to be allowed to start at all. -->
        <service
            android:name=".service.LocationTrackerService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
