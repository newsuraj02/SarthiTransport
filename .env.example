VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair — Firebase Console → Project Settings →
# Cloud Messaging → Web configuration → "Generate key pair".
VITE_FIREBASE_VAPID_KEY=

# Google Cloud project with Maps JavaScript API, Geocoding API, and Places
# API enabled + billing on, key restricted to your deployed domain.
VITE_GOOGLE_MAPS_API_KEY=

# Admin Portal login is now real Firebase Authentication (email/password),
# not an env var — see DEPLOYMENT.md → "Admin login" and
# scripts/setupAdmin.js. Nothing to set here.
